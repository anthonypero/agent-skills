            hint = {"over": "ease off", "under": "lean in", "on target": "hold"}
            print("  tilt: " + " · ".join(f"{b} {rep['tilt'][b]} ({hint[rep['tilt'][b]]})"
                                          for b in ("ccli", "historical", "new")))
            print(f"  slot-4 feel from history: " + ", ".join(
                f"{sp} {100 * v:.0f}%" for sp, v in sorted(rep["slot_feel"].get(4, {}).items(),
                                                           key=lambda kv: -kv[1])))
            print(f"  Pero originals (rule 12): {len(pb['committed'])}/{pb['budget']} of "
                  f"{pb['sundays']} Sundays committed; {len(pb['exempt'])} song(s) exempt (intro run)")
            print("\n## Sundays")
            for day in days:
                obs = [r for r in rep["rows"] if r["date"] == day["date"].isoformat() and r["obligation"]]
                print(f"{day['date']}  {day['liturgical_date'] or '-':<8}{day['season'] or '-':<10}"
                      f"{'communion' if day['communion'] else '':<10}[{day['theme_source']}]  "
                      f"{day['title'] or '(no sermon title)'}")
                print(f"{'':12}{day['scripture'] or '(no scripture — use the lectionary)'}")
                print(f"{'':12}leader: {day['leader'] or '(unknown)'}"
                      + ("" if day["mine"] else " — not yours; obligations only, no candidates"))
                if obs:
                    print(f"{'':12}obligation: " + ", ".join(f"{r['obligation']} (slot {r['slot']})" for r in obs))
                print(f"{'':12}pero: {day['pero']}")
            if args.out:
                cols = ["date", "liturgical_date", "season", "sermon_title", "scripture", "theme_source",
                        "leader", "slot", "slot_name", "obligation", "song", "candidates"]
                with open(args.out, "w", newline="", encoding="utf-8") as f:
                    w = csv.DictWriter(f, fieldnames=cols)
                    w.writeheader(); w.writerows(rep["rows"])
                print(f"\n{len(rep['rows'])} row(s) -> {args.out}", file=sys.stderr)
            return 0
        if args.songs_op == "chart":
            if not args.ref:
                raise RuntimeError("chart needs a song id or title")
            song = SV.find_song(client, args.ref)
            arrs = SV.get_arrangements(client, song["id"])
            if args.arrangement:
                arr = SV.find_arrangement(client, song["id"], args.arrangement)
            elif len(arrs) == 1:
                arr = arrs[0]
            else:
                raise RuntimeError("song has %d arrangements; pick one with --arrangement: %s"
                                   % (len(arrs), ", ".join(a["attributes"]["name"] for a in arrs)))
            label = f"{song['attributes']['title']} / {arr['attributes']['name']} (song {song['id']}, arr {arr['id']})"
            if not args.file:
                print(SV.get_arrangement(client, song["id"], arr["id"])["attributes"].get("chord_chart") or "")
                return 0
            with open(args.file, encoding="utf-8") as f:
                text = f.read()

#!/usr/bin/env python3
"""
pco — Planning Center API CLI. Layer 0: generic authenticated verbs against
any PCO product endpoint, with pagination and rate-limit handling built in.

Usage:
    pco get <path> [--all]              GET; --all follows pagination and
                                        prints a JSON array of every item
    pco post <path> --data <json>       POST (--data also accepts @file or
    pco patch <path> --data <json>       '-' for stdin)
    pco delete <path>
    pco whoami                          identity + credential-source check
    pco profiles                        list ~/.config/pco/credentials.md
                                        profiles and the source in effect
    pco init                            create ~/.config/pco/credentials.md
                                        from a template (chmod 600)

  Services (layer 1 — named operations; <type> is an id or name substring):
    pco services tags                   tag groups + tags (song/arrangement/person/media)
    pco services songs export [--out library.json] [--include-hidden]
        [--no-lyrics] [--no-attachments]    full library: songs, tags, arrangements,
                                        keys, lyrics, attachment filenames
    pco services songs tag <song id|title> [--arrangement <id|name>]
        [--add TAG ...] [--remove TAG ...] [--dry-run]
                                        tag names may be qualified "Group:Tag";
                                        single-select groups swap automatically
    pco services songs apply-tags --csv file [--dry-run]
                                        bulk: columns song, arrangement (optional),
                                        add, remove (";"-separated tag names)
    pco services songs chart <song id|title> [--arrangement <id|name>]
        [--file chart.txt] [--key E] [--dry-run]   read (no --file) or replace an arrangement's
                                        Lyrics & Chords chart (PCO dialect, see reference/services.md)
    pco services songs audit --from library.json [--group NAME]
                                        songs/arrangements with no tag from a group
    pco services types
    pco services song-usage <type> --after D [--before D] [--csv out.csv]
                                        every song item in the range: date,
                                        section, title, arrangement, key
    pco services templates <type>
    pco services plans <type> [--after YYYY-MM-DD] [--before YYYY-MM-DD]
    pco services extend <type> --through YYYY-MM-DD --template <name|id>
        [--communion-template <name|id>] [--communion-dates D,D,...]
        [--no-communion-rule] [--dry-run]
        Creates weekly plans after the latest existing one: plan + plan
        times copied from that plan, then imports the template (the
        communion template on first Sundays / listed dates).
    pco services fill <type> --csv <file> [--date-col d] [--title-col ...]
        [--series-col ...] [--scripture-col ...] [--scripture-item "Scripture Reading"]
        [--blank-series "Stand Alone"] [--after D] [--before D] [--overwrite] [--dry-run]
        From a worship-planning CSV (one row per service date), sets each
        matching plan's title + series and the Scripture Reading item's
        description. Empty cells skipped; filled fields kept unless --overwrite.
    pco services set <type> <date> [--title T] [--series S] [--scripture REF]
        Same, for one plan, values on the command line.
    pco services schedule <type> --csv <file> --position Speaker [--name-col Preacher]
        [--date-col d] [--after D] [--before D] [--status U|C] [--dry-run]
        [--other-of "Justin Lowe,Melissa Lowe"]
        Schedules the person named in each row into that team position on
        the plan for that date, matching against the position's roster
        (honorifics stripped). Unmatched names (guests) and already-filled
        positions are skipped. No notification is sent. With --other-of,
        the scheduled person is instead the OTHER member of the pair (e.g.
        --position Host: whoever isn't preaching hosts) unless the row's
        text marks them absent ("Melissa @ Reynolds", "Justin at ...").
    pco services remove-item <type> "<item title>" [--template NAME|ID ...]
        [--all-templates] [--dates D,D,...] [--after D] [--before D] [--dry-run]
        Deletes items with that title from the named templates and/or the
        plans on those dates (e.g. drop Children's Moment from communion).

    Global: --profile <name>            pick a ~/.config/pco/credentials.md
                                        profile (default: $PCO_PROFILE or
                                        the nearest project's secrets file —
                                        see lib/pco_api.py for the order)

Paths include the product prefix: /services/v2/songs, /people/v2/people, ...
Output is pretty-printed JSON on stdout; exit 1 on API errors.
"""

import argparse
import json
import os
import sys

# Resolve through symlinks so an installed ~/.local/bin/pco still finds lib/.
_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(_HERE), "lib"))
import datetime as dt

from pco_api import (CONFIG_PATH, PCOClient, init_credentials, list_profiles,
                     resolve_credentials)


def load_data(arg: str) -> dict:
    if arg == "-":
        return json.loads(sys.stdin.read())
    if arg.startswith("@"):
        with open(arg[1:], "r", encoding="utf-8") as f:
            return json.loads(f.read())
    return json.loads(arg)


def _date(s: str) -> dt.date:
    return dt.date.fromisoformat(s)


def services_main(argv: list[str], profile: str | None) -> int:
    import pco_plans as P
    parser = argparse.ArgumentParser(prog="pco services",
                                     description="Planning Center Services operations.")
    sub = parser.add_subparsers(dest="op", required=True)
    sub.add_parser("types", help="list service types")
    sub.add_parser("tags", help="list tag groups and tags")
    p = sub.add_parser("songs", help="song library operations")
    p.add_argument("songs_op", choices=["export", "tag", "apply-tags", "audit", "chart"])
    p.add_argument("ref", nargs="?", help="tag: song id or exact title")
    p.add_argument("--out", help="export: write JSON here (default stdout)")
    p.add_argument("--include-hidden", action="store_true")
    p.add_argument("--no-lyrics", action="store_true"); p.add_argument("--no-attachments", action="store_true")
    p.add_argument("--arrangement", help="tag: arrangement id|name (tags the arrangement, not the song)")
    p.add_argument("--add", action="append", default=[]); p.add_argument("--remove", action="append", default=[])
    p.add_argument("--csv", help="apply-tags: bulk CSV")
    p.add_argument("--from", dest="from_json", help="audit: library.json from export")
    p.add_argument("--group", help="audit: only this tag group")
    p.add_argument("--file", help="chart: Lyrics & Chords text to write (omit to print the current chart)")
    p.add_argument("--key", help="chart: also set chord_chart_key (e.g. E)")
    p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("song-usage", help="song items across plans in a date range")
    p.add_argument("type"); p.add_argument("--after", type=_date, required=True)
    p.add_argument("--before", type=_date); p.add_argument("--csv", help="write CSV here (default: stdout)")
    p = sub.add_parser("templates", help="list plan templates"); p.add_argument("type")
    p = sub.add_parser("plans", help="list plans"); p.add_argument("type")
    p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p = sub.add_parser("extend", help="create weekly plans through a date")
    p.add_argument("type"); p.add_argument("--through", type=_date, required=True)
    p.add_argument("--template", required=True, help="regular-week template name|id")
    p.add_argument("--communion-template", help="template for communion Sundays")
    p.add_argument("--communion-dates", default="",
                   help="comma-separated YYYY-MM-DD dates that are communion")
    p.add_argument("--no-communion-rule", action="store_true",
                   help="disable the first-Sunday-of-month default")
    p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("fill", help="set title/series/scripture on plans from a CSV")
    p.add_argument("type"); p.add_argument("--csv", required=True)
    p.add_argument("--date-col", default="d"); p.add_argument("--title-col", default="Sermon Title")
    p.add_argument("--series-col", default="Sermon Series")
    p.add_argument("--scripture-col", default="Sermon Scripture/")
    p.add_argument("--scripture-item", default="Scripture Reading")
    p.add_argument("--blank-series", default="Stand Alone",
                   help="comma-separated series values meaning 'no series' (skipped)")
    p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p.add_argument("--overwrite", action="store_true"); p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("set", help="set title/series/scripture on one plan")
    p.add_argument("type"); p.add_argument("date", type=_date)
    p.add_argument("--title"); p.add_argument("--series"); p.add_argument("--scripture")
    p.add_argument("--scripture-item", default="Scripture Reading")
    p.add_argument("--overwrite", action="store_true"); p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("schedule", help="schedule people into a position from a CSV")
    p.add_argument("type"); p.add_argument("--csv", required=True)
    p.add_argument("--position", required=True); p.add_argument("--name-col", default="Preacher")
    p.add_argument("--date-col", default="d")
    p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p.add_argument("--status", default="U", choices=["U", "C"]); p.add_argument("--dry-run", action="store_true")
    p.add_argument("--other-of", help='"Full Name,Full Name": schedule the pair member NOT named')
    p = sub.add_parser("remove-item", help="delete an item by title from templates/plans")
    p.add_argument("type"); p.add_argument("title")
    p.add_argument("--template", action="append", default=[], help="repeatable")
    p.add_argument("--all-templates", action="store_true")
    p.add_argument("--dates", default="", help="comma-separated YYYY-MM-DD")
    p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)

    client = PCOClient(profile=profile)
    if args.op == "tags":
        import pco_services as SV
        for g in SV.get_tag_groups(client):
            print(f"{g['id']:>8}  {g['name']:<20} for={g['tags_for']:<12} "
                  f"multiple={'yes' if g['allow_multiple'] else 'no '}  "
                  + ", ".join(t["name"] for t in g["tags"]))
        return 0
    if args.op == "songs":
        import pco_services as SV
        if args.songs_op == "export":
            lib = SV.export_library(client, args.include_hidden,
                                    log=lambda m: print(m, file=sys.stderr),
                                    lyrics=not args.no_lyrics, attachments=not args.no_attachments)
            out = open(args.out, "w", encoding="utf-8") if args.out else sys.stdout
            json.dump(lib, out, indent=2); out.write("\n")
            print(f"{len(lib)} songs exported", file=sys.stderr)
            return 0
        if args.songs_op == "audit":
            if not args.from_json:
                raise RuntimeError("audit needs --from library.json (see songs export)")
            with open(args.from_json, encoding="utf-8") as f:
                lib = json.load(f)
            for group, gaps in SV.audit_library(lib, SV.get_tag_groups(client)).items():
                if args.group and group.lower() != args.group.lower():
                    continue
                print(f"## {group}: {len(gaps)} missing")
                for g in gaps:
                    print(f"  {g}")
            return 0
        if args.songs_op == "chart":
            if not args.ref:
                raise RuntimeError("chart needs a song id or title")
            song = SV.find_song(client, args.ref)
            arrs = SV.get_arrangements(client, song["id"])
            if args.arrangement:
                arr = SV.find_arrangement(client, song["id"], args.arrangement)
            elif len(arrs) == 1:
                arr = arrs[0]
            else:
                raise RuntimeError("song has %d arrangements; pick one with --arrangement: %s"
                                   % (len(arrs), ", ".join(a["attributes"]["name"] for a in arrs)))
            label = f"{song['attributes']['title']} / {arr['attributes']['name']} (song {song['id']}, arr {arr['id']})"
            if not args.file:
                print(SV.get_arrangement(client, song["id"], arr["id"])["attributes"].get("chord_chart") or "")
                return 0
            with open(args.file, encoding="utf-8") as f:
                text = f.read()
            attrs = {"chord_chart": text}
            if args.key:
                attrs["chord_chart_key"] = args.key
            had = bool(arr["attributes"].get("chord_chart"))
            if args.dry_run:
                print(f"{label}: would {'REPLACE existing' if had else 'set'} chart "
                      f"({len(text.splitlines())} lines{', key ' + args.key if args.key else ''})  [dry-run]")
                return 0
            SV.update_arrangement(client, song["id"], arr["id"], attrs)
            print(f"{label}: chart {'replaced' if had else 'set'} ({len(text.splitlines())} lines)")
            return 0
        index = SV.TagIndex(client)

        def do(song_ref, arr_ref, add, remove):
            song = SV.find_song(client, song_ref)
            if arr_ref:
                arr = SV.find_arrangement(client, song["id"], arr_ref)
                path, scope = SV.arrangement_path(song["id"], arr["id"]), "arrangement"
                label = f"{song['attributes']['title']} / {arr['attributes']['name']}"
            else:
                path, scope, label = SV.song_path(song["id"]), "song", song["attributes"]["title"]
            before, after = SV.retag(client, index, path, scope, add, remove, args.dry_run)
            mark = "  [dry-run]" if args.dry_run else ("" if before != after else "  (no change)")
            print(f"{label}: {before} -> {after}{mark}")

        if args.songs_op == "tag":
            if not args.ref:
                raise RuntimeError("tag needs a song id or title")
            do(args.ref, args.arrangement, args.add, args.remove)
            return 0
        if args.songs_op == "apply-tags":
            import csv
            if not args.csv:
                raise RuntimeError("apply-tags needs --csv")
            with open(args.csv, newline="", encoding="utf-8") as f:
                for r in csv.DictReader(f):
                    split = lambda v: [x.strip() for x in (v or "").split(";") if x.strip()]
                    do(r["song"], (r.get("arrangement") or None), split(r.get("add")), split(r.get("remove")))
            return 0
    if args.op == "types":
        for t in P.get_service_types(client):
            a = t["attributes"]
            print(f"{t['id']:>8}  {a['name']:<40} {a.get('frequency') or ''}")
        return 0
    st = P.resolve_service_type(client, args.type)
    if args.op == "song-usage":
        import csv
        rows = P.song_usage(client, st["id"], args.after, args.before or dt.date.today(),
                            log=lambda m: print(m, file=sys.stderr))
        out = open(args.csv, "w", newline="", encoding="utf-8") if args.csv else sys.stdout
        w = csv.DictWriter(out, fieldnames=["date", "plan_id", "sequence", "section", "title",
                                            "song_id", "arrangement", "key", "length"])
        w.writeheader(); w.writerows(rows)
        print(f"{len(rows)} song items across the range", file=sys.stderr)
        return 0
    if args.op == "templates":
        for t in P.get_plan_templates(client, st["id"]):
            a = t["attributes"]
            print(f"{t['id']:>8}  {a['name']:<30} items={a.get('item_count')} "
                  f"teams={a.get('team_count')} updated={a.get('updated_at','')[:10]}")
        return 0
    if args.op == "plans":
        after = args.after or dt.date.today()
        for pl in P.get_plans(client, st["id"], after, args.before):
            a = pl["attributes"]
            print(f"{pl['id']:>9}  {a['sort_date'][:10]}  items={a['items_count']:<3} "
                  f"title={a.get('title') or '-'} | series={a.get('series_title') or '-'}")
        return 0
    if args.op == "extend":
        tpl = P.resolve_template(client, st["id"], args.template)["id"]
        ctpl = (P.resolve_template(client, st["id"], args.communion_template)["id"]
                if args.communion_template else None)
        dates = {_date(x) for x in args.communion_dates.split(",") if x}
        rule = (lambda d: False) if args.no_communion_rule else P.first_sunday_of_month
        created = P.extend_plans(client, st["id"], args.through, tpl, ctpl, rule, dates,
                                 dry_run=args.dry_run, log=lambda m: print(m, file=sys.stderr))
        for pl in created:
            print(pl["attributes"].get("planning_center_url") or pl["id"])
        return 0
    if args.op in ("fill", "set"):
        if args.op == "set":
            rows = [{"date": args.date, "title": args.title, "series": args.series,
                     "scripture": args.scripture}]
        else:
            import csv
            with open(args.csv, newline="", encoding="utf-8") as f:
                reader = csv.DictReader(f)
                missing = [c for c in (args.date_col, args.title_col, args.series_col,
                                       args.scripture_col) if c not in reader.fieldnames]
                if missing:
                    raise RuntimeError(f"CSV lacks columns {missing}; has {reader.fieldnames}")
                blank = {x.strip().lower() for x in args.blank_series.split(",") if x.strip()}
                rows = []
                for r in reader:
                    if (r[args.series_col] or "").strip().lower() in blank:
                        r[args.series_col] = ""
                    d = P.parse_sheet_date(r[args.date_col] or "")
                    if not d or (args.after and d < args.after) or (args.before and d > args.before):
                        continue
                    rows.append({"date": d, "title": r[args.title_col],
                                 "series": r[args.series_col], "scripture": r[args.scripture_col]})
        n = P.fill_plans(client, st["id"], rows, args.scripture_item, args.overwrite,
                         args.dry_run, log=lambda m: print(m, file=sys.stderr))
        print(f"{n} plan(s) {'would be ' if args.dry_run else ''}updated")
        return 0
    if args.op == "schedule":
        import csv
        with open(args.csv, newline="", encoding="utf-8") as f:
            reader = csv.DictReader(f)
            for c in (args.date_col, args.name_col):
                if c not in reader.fieldnames:
                    raise RuntimeError(f"CSV lacks column {c!r}; has {reader.fieldnames}")
            pair = tuple(x.strip() for x in args.other_of.split(",")) if args.other_of else None
            if pair and len(pair) != 2:
                raise RuntimeError("--other-of needs exactly two comma-separated names")
            rows = []
            for r in reader:
                d = P.parse_sheet_date(r[args.date_col] or "")
                if not d or (args.after and d < args.after) or (args.before and d > args.before):
                    continue
                name = r[args.name_col] or ""
                if pair and name.strip():
                    name = P.counterpart_name(name, pair, " ".join(v or "" for v in r.values()),
                                              log=lambda m: print(m, file=sys.stderr), when=str(d)) or ""
                rows.append({"date": d, "name": name})
        n = P.schedule_from_rows(client, st["id"], rows, args.position, args.status,
                                 args.dry_run, log=lambda m: print(m, file=sys.stderr))
        print(f"{n} person(s) {'would be ' if args.dry_run else ''}scheduled")
        return 0
    if args.op == "remove-item":
        tids = ([t["id"] for t in P.get_plan_templates(client, st["id"])] if args.all_templates
                else [P.resolve_template(client, st["id"], t)["id"] for t in args.template])
        dates = [_date(x) for x in args.dates.split(",") if x]
        if not tids and not dates and not (args.after or args.before):
            raise RuntimeError("give --template/--all-templates, --dates, or --after/--before")
        n = P.remove_item(client, st["id"], args.title, tids, dates, args.after, args.before,
                          args.dry_run, log=lambda m: print(m, file=sys.stderr))
        print(f"{n} item(s) {'would be ' if args.dry_run else ''}deleted")
        return 0
    return 1


def main(argv: list[str]) -> int:
    # Product subcommands get their own parser (argparse can't mix a flat
    # verb list with nested subcommands cleanly).
    profile = None
    rest = argv[1:]
    if rest[:1] in (["--profile"], ["-P"]) and len(rest) > 1:
        profile, rest = rest[1], rest[2:]
    if rest[:1] == ["services"]:
        try:
            return services_main(rest[1:], profile)
        except (RuntimeError, OSError) as e:
            print(f"pco: {e}", file=sys.stderr)
            return 1
    parser = argparse.ArgumentParser(
        prog="pco", description="Planning Center API CLI (generic verbs).")
    parser.add_argument("--profile", "-P", default=None,
                        help="Credentials profile in ~/.config/pco/credentials.md")
    parser.add_argument("verb", choices=["get", "post", "patch", "delete", "whoami", "profiles", "init"])
    parser.add_argument("path", nargs="?",
                        help="API path incl. product prefix, e.g. /services/v2/songs")
    parser.add_argument("--data", "-d",
                        help="JSON body for post/patch (literal, @file, or '-').")
    parser.add_argument("--all", action="store_true",
                        help="get: follow pagination, print every item as one array.")
    args = parser.parse_args(argv[1:])

    if args.verb == "init":
        created = init_credentials()
        print(("Created" if created else "Already exists:") + f" {CONFIG_PATH}"
              + (" — fill in your tokens." if created else ""))
        return 0
    if args.verb == "profiles":
        profiles = list_profiles()
        if not profiles:
            print(f"No profiles: {CONFIG_PATH} missing or empty (run `pco init`).")
        for name, ok in sorted(profiles.items()):
            print(f"  {name:<20} {'ok' if ok else 'INCOMPLETE'}")
        try:
            _, _, source = resolve_credentials(profile=args.profile)
            print(f"In effect: {source}")
        except RuntimeError as e:
            print(f"In effect: none ({e})")
        return 0
    if args.verb not in ("whoami",) and not args.path:
        parser.error(f"'{args.verb}' requires a path")
    if args.verb in ("post", "patch") and not args.data:
        parser.error(f"'{args.verb}' requires --data")

    try:
        client = PCOClient(profile=args.profile)
        if args.verb == "whoami":
            me = client.get("/people/v2/me")["data"]
            a = me["attributes"]
            result = {"id": me["id"], "name": a.get("name"),
                      "credentials": client.credential_source}
        elif args.verb == "get" and args.all:
            result = list(client.get_all(args.path))
        elif args.verb == "get":
            result = client.get(args.path)
        elif args.verb == "delete":
            result = client.delete(args.path) or {"deleted": args.path}
        else:
            result = getattr(client, args.verb)(args.path, load_data(args.data))
    except (RuntimeError, json.JSONDecodeError, OSError) as e:
        print(f"pco: {e}", file=sys.stderr)
        return 1

    json.dump(result, sys.stdout, indent=2)
    print()
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))

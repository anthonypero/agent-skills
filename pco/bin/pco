                print(f"{s:<13}{rep['counts'].get(s, 0):>5}")
            print(f"\ntransitions ({len(rep['rows'])} row(s) to write):")
            for k, n in sorted(rep["transitions"].items(), key=lambda kv: -kv[1]):

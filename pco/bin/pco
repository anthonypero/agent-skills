                      f"{args.intro_weeks} weeks — nothing owed; retire by hand if it didn't work):")
                for o in ob["stale"]:
                    print(f"  {o['title']} — debut {o['debut']}, {o['uses']} use(s), last {o['last']}")
            print("queued (Tony's new-song pool; the planner never picks a debut):"
                  if ob["queued"] else "queued (new-song pool): none")

    if args.op in ("snapshot", "changes"):
        import os.path as _osp
        import pco_snapshot as S
        root = _snapshot_dir(args.dir)
        after = args.after or dt.date.today()
        before = args.before or (after + dt.timedelta(weeks=args.weeks) if args.op == "snapshot"
                                 else dt.date.max)
        if args.op == "snapshot":
            reps = S.snapshot_plans(client, root, st, after, before,
                                    log=lambda m: print(m, file=sys.stderr))
            for r in reps:
                if args.quiet and not r["changed"]:
                    continue
                head = f"{r['date']}  {r['title'] or '-'}  (plan {r['plan_id']}; last edit {r['updated_at']} by {r['updated_by'] or '?'})"
                if r["first"]:
                    print(f"{head}\n  first snapshot")
                elif r["changed"]:
                    print(f"{head}\n  CHANGED since {r['previous']}:")
                    for l in r["lines"]:
                        print(f"    {l}")
                else:
                    print(f"{head}\n  unchanged since {r['previous']}")
            n = sum(r["changed"] for r in reps)
            print(f"{len(reps)} plan(s), {n} changed, stored in {root}", file=sys.stderr)
            return 0
        since = None
        if args.since:
            since = dt.datetime.fromisoformat(args.since)
            if since.tzinfo is None:
                since = since.astimezone()
        idx_path = _osp.join(root, "index.json")
        idx = json.load(open(idx_path)) if _osp.isfile(idx_path) else {}
        plans = sorted(((m["date"], pid, m) for pid, m in idx.items()
                        if m["service_type_id"] == st["id"]
                        and after <= dt.date.fromisoformat(m["date"]) <= before))
        for date, pid, m in plans:
            old, new, lines = S.changes_since(root, st["id"], pid, since)
            checked = S.last_checked(root, st["id"], pid)
            head = f"{date}  {m.get('title') or '-'}  (plan {pid}; last checked {checked})"
            if lines:
                print(f"{head}\n  CHANGED {old} -> {new}:")
                for l in lines:
                    print(f"    {l}")
            else:
                print(f"{head}\n  no changes" + (f" since {old or new}" if (old or new) else " (no snapshots)"))
        if not plans:
            print(f"no snapshots for {st['attributes']['name']} in range under {root}")
        return 0
    if args.op == "plans":

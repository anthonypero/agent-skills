            for o in ob["runs"]:
                print(f"  {o['title']} — debut {o['debut']}, {o['uses']} of {args.run.split('/')[0]} "
                      f"use(s) scheduled ({o['sung']} sung by {as_of}), needs {o['need']} more, {o['window']}")
                print("    Sundays left: " + (", ".join(str(d) for d in o["sundays"]) or "NONE")
                      + (f"  (else by {o['fallback']})" if o["fallback"] else ""))
                print("    pinned: " + (", ".join(f"{d} slot {o['slot']}" for d in o["pin"]) or "nowhere"))
                if o["short"]:
                    print("    NOTE: " + ("the run spills past this period — it finishes in the next one"
                                          if o["sundays"] and not o["pin"] else
                                          "not enough Sundays left in the window — widen the run or re-debut"))
                if o["straddles_advent"]:
                    print(f"    WARNING: run would straddle Advent 1 ({rep['advent1']}) — Advent is planned separately")
            print(f"follow-ups due ({len(ob['follow_ups'])}):" if ob["follow_ups"] else "follow-ups due: none")
            for o in ob["follow_ups"]:

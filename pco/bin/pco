    if args.op == "schedule-grid":
        import csv
        with open(args.csv, newline="", encoding="utf-8") as f:
            rows = []
            for r in csv.DictReader(f):
                d = P.parse_sheet_date(r.get("date") or "")
                if not d or (args.after and d < args.after) or (args.before and d > args.before):
                    continue
                rows.append({"date": d, "team": r.get("team") or "", "position": r.get("position") or "",
                             "person": r.get("person") or ""})

#!/usr/bin/env python3
"""
pco — Planning Center API CLI. Layer 0: generic authenticated verbs against
any PCO product endpoint, with pagination and rate-limit handling built in.

Usage:
    pco get <path> [--all]              GET; --all follows pagination and
                                        prints a JSON array of every item
    pco post <path> --data <json>       POST (--data also accepts @file or
    pco patch <path> --data <json>       '-' for stdin)
    pco delete <path>
    pco whoami                          identity + credential-source check
    pco profiles                        list ~/.config/pco/credentials.md
                                        profiles and the source in effect
    pco init                            create ~/.config/pco/credentials.md
                                        from a template (chmod 600)

  Services (layer 1 — named operations; <type> is an id or name substring):
    pco services tags                   tag groups + tags (song/arrangement/person/media)
    pco services songs export [--out library.json] [--include-hidden]
        [--no-lyrics] [--no-attachments]    full library: songs, tags, arrangements,
                                        keys, lyrics, attachment filenames
    pco services songs tag <song id|title> [--arrangement <id|name>]
        [--add TAG ...] [--remove TAG ...] [--dry-run]
                                        tag names may be qualified "Group:Tag";
                                        single-select groups swap automatically
    pco services songs apply-tags --csv file [--dry-run]
                                        bulk: columns song, arrangement (optional),
                                        add, remove (";"-separated tag names)
    pco services songs chart <song id|title> [--arrangement <id|name>]
        [--file chart.txt] [--key E] [--dry-run]   read (no --file) or replace an arrangement's
                                        Lyrics & Chords chart (PCO dialect, see reference/services.md)
    pco services songs audit --from library.json [--group NAME]
                                        songs/arrangements with no tag from a group
    pco services songs lifecycle --usage all.csv --from library.json [--out lifecycle.csv]
        [--as-of D] [--new-threshold 4] [--dormant-months 24]
        [--seasonal-tags Christmas,Easter,Patriotic] [--current-tag Current]
                                        offline: each song's Lifecycle state (Queued /
                                        Introducing / Rotation / Dormant / Retired) from
                                        its usage history -> retag CSV + summary
    pco services songs plan --usage all.csv --from library.json --sheet worship.csv
        --after D --before D [--as-of D] [--period-start D] [--out plan.csv] [--lookback-weeks 12]
        [--run 3/4] [--follow-up-weeks 4-8] [--candidates 8] [--exclude REGEX]
        [--leaders leaders.csv --self "Your Name"]
                                        offline: a first-pass song plan for one period —
                                        carry-over obligations (rule 11), the trailing-year
                                        mix tilt, a per-Sunday theme summary, and a CSV of
                                        4 slots per Sunday with ranked, annotated
                                        candidates. The song column stays blank: Tony fills it.
    pco services snapshot <type> [--after D] [--before D | --weeks 6] [--dir DIR] [--quiet]
                                        fetch each plan (items, songs/keys, notes, team,
                                        times); store a version only when it changed;
                                        print what changed vs the previous snapshot
    pco services changes <type> [--after D] [--before D] [--since D] [--dir DIR]
                                        offline: diff stored snapshots (latest vs the
                                        previous one, or vs the newest at/before --since)
    pco services types
    pco services song-usage <type> --after D [--before D] [--csv out.csv]
                                        every song item in the range: date,
                                        section, title, arrangement, key
    pco services templates <type>
    pco services plans <type> [--after YYYY-MM-DD] [--before YYYY-MM-DD]
        [--leaders [--position "Music Director"] [--csv leaders.csv]]
                                        --leaders writes date,plan_id,music_director —
                                        the CSV `songs plan --leaders` reads
    pco services extend <type> --through YYYY-MM-DD --template <name|id>
        [--communion-template <name|id>] [--communion-dates D,D,...]
        [--no-communion-rule] [--dry-run]
        Creates weekly plans after the latest existing one: plan + plan
        times copied from that plan, then imports the template (the
        communion template on first Sundays / listed dates).
    pco services fill <type> --csv <file> [--date-col d] [--title-col ...]
        [--series-col ...] [--scripture-col ...] [--scripture-item "Scripture Reading"]
        [--blank-series "Stand Alone"] [--after D] [--before D] [--overwrite] [--dry-run]
        From a worship-planning CSV (one row per service date), sets each
        matching plan's title + series and the Scripture Reading item's
        description. Empty cells skipped; filled fields kept unless --overwrite.
    pco services set <type> <date> [--title T] [--series S] [--scripture REF]
        Same, for one plan, values on the command line.
    pco services schedule <type> --csv <file> --position Speaker [--name-col Preacher]
        [--date-col d] [--after D] [--before D] [--status U|C] [--dry-run]
        [--other-of "Justin Lowe,Melissa Lowe"]
        Schedules the person named in each row into that team position on
        the plan for that date, matching against the position's roster
        (honorifics stripped). Unmatched names (guests) and already-filled
        positions are skipped. No notification is sent. With --other-of,
        the scheduled person is instead the OTHER member of the pair (e.g.
        --position Host: whoever isn't preaching hosts) unless the row's
        text marks them absent ("Melissa @ Reynolds", "Justin at ...").
    pco services remove-item <type> "<item title>" [--template NAME|ID ...]
        [--all-templates] [--dates D,D,...] [--after D] [--before D] [--dry-run]
        Deletes items with that title from the named templates and/or the
        plans on those dates (e.g. drop Children's Moment from communion).

    Global: --profile <name>            pick a ~/.config/pco/credentials.md
                                        profile (default: $PCO_PROFILE or
                                        the nearest project's secrets file —
                                        see lib/pco_api.py for the order)

Paths include the product prefix: /services/v2/songs, /people/v2/people, ...
Output is pretty-printed JSON on stdout; exit 1 on API errors.
"""

import argparse
import json
import os
import sys

# Resolve through symlinks so an installed ~/.local/bin/pco still finds lib/.
_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(_HERE), "lib"))
import datetime as dt

from pco_api import (CONFIG_PATH, PCOClient, init_credentials, list_profiles,
                     profile_setting, resolve_credentials)


def load_data(arg: str) -> dict:
    if arg == "-":
        return json.loads(sys.stdin.read())
    if arg.startswith("@"):
        with open(arg[1:], "r", encoding="utf-8") as f:
            return json.loads(f.read())
    return json.loads(arg)


def _date(s: str) -> dt.date:
    return dt.date.fromisoformat(s)


def _snapshot_dir(explicit: str | None) -> str:
    """--dir, else $PCO_SNAPSHOT_DIR (env / project secrets / profile), else
    <project>/.agents/pco-snapshots next to the nearest PROJECT_SECRETS.md,
    else ~/.config/pco/snapshots."""
    from pco_api import profile_setting, _nearest_project_secrets
    if explicit:
        return explicit
    setting = profile_setting("PCO_SNAPSHOT_DIR")
    if setting:
        return os.path.expanduser(setting)
    secrets = _nearest_project_secrets(os.getcwd())
    if secrets:
        return os.path.join(os.path.dirname(secrets), "pco-snapshots")
    return os.path.expanduser("~/.config/pco/snapshots")


def services_main(argv: list[str], profile: str | None) -> int:
    import pco_plans as P
    parser = argparse.ArgumentParser(prog="pco services",
                                     description="Planning Center Services operations.")
    sub = parser.add_subparsers(dest="op", required=True)
    sub.add_parser("types", help="list service types")
    sub.add_parser("tags", help="list tag groups and tags")
    p = sub.add_parser("songs", help="song library operations")
    p.add_argument("songs_op", choices=["export", "tag", "apply-tags", "audit", "chart", "mix",
                                        "lifecycle", "plan", "flag", "apply-plan"])
    p.add_argument("ref", nargs="?", help="tag: song id or exact title")
    p.add_argument("--out", help="export: write JSON here (default stdout)")
    p.add_argument("--include-hidden", action="store_true")
    p.add_argument("--no-lyrics", action="store_true"); p.add_argument("--no-attachments", action="store_true")
    p.add_argument("--arrangement", help="tag: arrangement id|name (tags the arrangement, not the song)")
    p.add_argument("--add", action="append", default=[]); p.add_argument("--remove", action="append", default=[])
    p.add_argument("--csv", help="apply-tags: bulk CSV")
    p.add_argument("--from", dest="from_json", help="audit: library.json from export")
    p.add_argument("--group", help="audit: only this tag group")
    p.add_argument("--file", help="chart: Lyrics & Chords text to write (omit to print the current chart)")
    p.add_argument("--key", help="chart: also set chord_chart_key (e.g. E)")
    p.add_argument("--usage", help="mix: full-history song-usage CSV (all dates)")
    p.add_argument("--after", type=_date, help="mix: window start"); p.add_argument("--before", type=_date, help="mix: window end (default today)")
    p.add_argument("--target", default="40/40/20", help="mix: ccli/historical/new percentages")
    p.add_argument("--new-threshold", type=int, default=4, help="mix: a song is 'new' through its Nth use")
    p.add_argument("--new-months", type=int, default=24, help="mix: ...and only if first used within N months")
    p.add_argument("--exclude", help="mix: drop slots whose title matches this regex (liturgy, not song choices)")
    p.add_argument("--exclude-tags", default="Christmas,Easter,Patriotic",
                   help="mix: drop slots of songs carrying any of these tags (seasonal); '' to keep them")
    p.add_argument("--keep-advent", action="store_true", help="mix: count Advent 1 -> Jan 6 slots (skipped by default)")
    p.add_argument("--songs", action="store_true", help="mix: also list every song with its bucket(s)")
    p.add_argument("--dormant-months", type=int, default=24,
                   help="lifecycle: not used in N months -> Dormant")
    p.add_argument("--skip-intro-arr-tags", default="Modernized Hymn",
                   help="lifecycle: songs with an arrangement carrying any of these tags skip Introducing; '' to disable")
    p.add_argument("--tag", default="Worklist:Flagged", help="flag: the scratch tag to manage")
    p.add_argument("--ids", default="", help="flag: comma-separated song ids to flag (with --csv: added to it)")
    p.add_argument("--clear", action="store_true", help="flag: flag nothing (take the tag off the last list)")
    p.add_argument("--note", default="", help="flag: what this list means (kept with the state)")
    p.add_argument("--state", help="flag: state file (default ~/.local/share/pco/<profile>/flags.json)")
    p.add_argument("--intro-weeks", type=int, default=8, help="lifecycle: Introducing only while last use is within N weeks")
    p.add_argument("--as-of", type=_date, help="lifecycle: evaluate as of this date (default today)")
    p.add_argument("--seasonal-tags", default="Christmas,Easter,Patriotic",
                   help="lifecycle: songs with these tags skip Introducing; '' to disable")
    p.add_argument("--current-tag", default="Current",
                   help="lifecycle: tag Lifecycle supersedes; stripped where it still exists "
                        "('' to never strip)")
    p.add_argument("--sheet", help="plan: worship-planning CSV (sermon title/scripture/season per Sunday)")
    p.add_argument("--period-start", type=_date,
                   help="plan: the period's real first Sunday (default --after) — scopes the "
                        "no-repeat window and the Pero 1-in-3 average; rows still start at --after")
    p.add_argument("--lookback-weeks", type=int, default=12,
                   help="plan: look this far back across the period boundary for obligations")
    p.add_argument("--follow-up-weeks", default="4-8", help="plan: a run's deliberate repeat is due in this window")
    p.add_argument("--run", default="3/4", help="plan: an intro run is N of M Sundays")
    p.add_argument("--candidates", type=int, default=8, help="plan: candidates listed per slot")
    p.add_argument("--overrides", type=int, default=2,
                   help="plan: also list this many rule-breaking candidates per slot (rule 0); 0 for none")
    p.add_argument("--leaders", help="plan: CSV date,music_director (see plans --leaders); "
                                     "without it every Sunday is yours")
    p.add_argument("--self", dest="self_leader", default="",
                   help="plan: your name as it appears in --leaders "
                        "(default: PCO_SELF from the env/profile)")
    p.add_argument("--recency-weeks", type=int, default=12,
                   help="plan: candidates sung within N weeks are pushed down")
    p.add_argument("--mix-months", type=int, default=12, help="plan: the mix window the tilt is read from")
    p.add_argument("--type", dest="plan_type", help="apply-plan: service type name|id (default 01. Modern)")
    p.add_argument("--overwrite", action="store_true", help="apply-plan: replace slots that already hold a different song")
    p.add_argument("--clear-empty", action="store_true", help="apply-plan: a blank `song` cell empties a filled slot")
    p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("song-usage", help="song items across plans in a date range")
    p.add_argument("type"); p.add_argument("--after", type=_date, required=True)
    p.add_argument("--before", type=_date); p.add_argument("--csv", help="write CSV here (default: stdout)")
    p = sub.add_parser("templates", help="list plan templates"); p.add_argument("type")
    p = sub.add_parser("plans", help="list plans"); p.add_argument("type")
    p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p.add_argument("--leaders", action="store_true",
                   help="instead list who holds --position on each plan (feeds songs plan --leaders)")
    p.add_argument("--position", default="Music Director", help="--leaders: the team position to read")
    p.add_argument("--csv", help="--leaders: write the CSV here (default stdout)")
    p = sub.add_parser("snapshot", help="fetch plans and store a version when they changed; report diffs")
    p.add_argument("type"); p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p.add_argument("--weeks", type=int, default=6, help="default range: today .. today+N weeks")
    p.add_argument("--dir", help="snapshot root (default: $PCO_SNAPSHOT_DIR, else <project>/.agents/pco-snapshots)")
    p.add_argument("--quiet", action="store_true", help="only print plans that changed")
    p = sub.add_parser("changes", help="offline: what changed between stored snapshots")
    p.add_argument("type"); p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p.add_argument("--since", help="compare against the newest snapshot at/before this date or datetime (default: previous snapshot)")
    p.add_argument("--dir")
    p = sub.add_parser("teams", help="list teams; --members lists each person/position/preference")
    p.add_argument("type"); p.add_argument("--team", action="append", default=[], help="repeatable name|id (default: all)")
    p.add_argument("--members", action="store_true"); p.add_argument("--csv", help="--members: write CSV here")
    p = sub.add_parser("availability", help="set a person's scheduling preference on every position they hold on a team")
    p.add_argument("type"); p.add_argument("--team", required=True, action="append", help="repeatable name|id")
    p.add_argument("--person", required=True, action="append", help="repeatable full name")
    p.add_argument("--set", dest="preference", default="Unavailable",
                   help='"Unavailable" (default) or "As often as needed"')
    p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("extend", help="create weekly plans through a date")
    p.add_argument("type"); p.add_argument("--through", type=_date, required=True)
    p.add_argument("--template", required=True, help="regular-week template name|id")
    p.add_argument("--communion-template", help="template for communion Sundays")
    p.add_argument("--communion-dates", default="",
                   help="comma-separated YYYY-MM-DD dates that are communion")
    p.add_argument("--no-communion-rule", action="store_true",
                   help="disable the first-Sunday-of-month default")
    p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("fill", help="set title/series/scripture on plans from a CSV")
    p.add_argument("type"); p.add_argument("--csv", required=True)
    p.add_argument("--date-col", default="d"); p.add_argument("--title-col", default="Sermon Title")
    p.add_argument("--series-col", default="Sermon Series")
    p.add_argument("--scripture-col", default="Sermon Scripture/")
    p.add_argument("--scripture-item", default="Scripture Reading")
    p.add_argument("--blank-series", default="Stand Alone",
                   help="comma-separated series values meaning 'no series' (skipped)")
    p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p.add_argument("--overwrite", action="store_true"); p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("set", help="set title/series/scripture on one plan")
    p.add_argument("type"); p.add_argument("date", type=_date)
    p.add_argument("--title"); p.add_argument("--series"); p.add_argument("--scripture")
    p.add_argument("--scripture-item", default="Scripture Reading")
    p.add_argument("--overwrite", action="store_true"); p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("schedule", help="schedule people into a position from a CSV")
    p.add_argument("type"); p.add_argument("--csv", required=True)
    p.add_argument("--position", required=True); p.add_argument("--name-col", default="Preacher")
    p.add_argument("--date-col", default="d")
    p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p.add_argument("--status", default="U", choices=["U", "C"]); p.add_argument("--dry-run", action="store_true")
    p.add_argument("--other-of", help='"Full Name,Full Name": schedule the pair member NOT named')
    p = sub.add_parser("schedule-grid", help="schedule people from a date,team,position,person CSV (additive)")
    p.add_argument("type"); p.add_argument("--csv", required=True)
    p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p.add_argument("--status", default="U", choices=["U", "C"]); p.add_argument("--dry-run", action="store_true")
    p = sub.add_parser("remove-item", help="delete an item by title from templates/plans")
    p.add_argument("type"); p.add_argument("title")
    p.add_argument("--template", action="append", default=[], help="repeatable")
    p.add_argument("--all-templates", action="store_true")
    p.add_argument("--dates", default="", help="comma-separated YYYY-MM-DD")
    p.add_argument("--after", type=_date); p.add_argument("--before", type=_date)
    p.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)

    client = PCOClient(profile=profile)
    if args.op == "tags":
        import pco_services as SV
        for g in SV.get_tag_groups(client):
            print(f"{g['id']:>8}  {g['name']:<20} for={g['tags_for']:<12} "
                  f"multiple={'yes' if g['allow_multiple'] else 'no '} "
                  f"required={'yes' if g.get('required') else 'no '}  "
                  + ", ".join(t["name"] for t in g["tags"]))
        return 0
    if args.op == "songs":
        import pco_services as SV
        if args.songs_op == "export":
            lib = SV.export_library(client, args.include_hidden,
                                    log=lambda m: print(m, file=sys.stderr),
                                    lyrics=not args.no_lyrics, attachments=not args.no_attachments)
            out = open(args.out, "w", encoding="utf-8") if args.out else sys.stdout
            json.dump(lib, out, indent=2); out.write("\n")
            print(f"{len(lib)} songs exported", file=sys.stderr)
            return 0
        if args.songs_op == "audit":
            if not args.from_json:
                raise RuntimeError("audit needs --from library.json (see songs export)")
            with open(args.from_json, encoding="utf-8") as f:
                lib = json.load(f)
            for group, gaps in SV.audit_library(lib, SV.get_tag_groups(client)).items():
                if args.group and group.lower() != args.group.lower():
                    continue
                print(f"## {group}: {len(gaps)} missing")
                for g in gaps:
                    print(f"  {g}")
            return 0
        if args.songs_op == "mix":
            import csv
            if not (args.usage and args.from_json and args.after):
                raise RuntimeError("mix needs --usage all.csv --from library.json --after D [--before D]")
            with open(args.from_json, encoding="utf-8") as f:
                lib = json.load(f)
            with open(args.usage, newline="", encoding="utf-8") as f:
                usage = list(csv.DictReader(f))
            before = args.before or dt.date.today()
            rep = SV.mix_report(usage, lib, args.after, before, new_threshold=args.new_threshold,
                                new_months=args.new_months, exclude=args.exclude,
                                exclude_tags=tuple(t.strip() for t in args.exclude_tags.split(",") if t.strip()),
                                exclude_ranges=[] if args.keep_advent else SV.advent_windows(args.after, before))
            tgt = dict(zip(("ccli", "historical", "new"), (int(x) for x in args.target.split("/"))))
            total = sum(rep["totals"].values()) or 1
            print(f"{args.after} -> {before}: {total} slots, {len(rep['songs'])} distinct songs"
                  + (f", {rep['dropped']} excluded" if rep["dropped"] else ""))
            print(f"{'bucket':<12}{'slots':>6}{'pct':>6}{'target':>8}{'delta':>7}")
            for b in ("ccli", "historical", "new"):
                n = rep["totals"].get(b, 0); pct = 100 * n / total
                print(f"{b:<12}{n:>6}{pct:>5.0f}%{tgt[b]:>7}%{pct - tgt[b]:>+6.0f}")
            print("by section:")
            for sec, c in rep["by_section"].items():
                st = sum(c.values())
                print(f"  {sec:<28}{st:>4}  " + "  ".join(f"{b} {c.get(b, 0):>3} ({100 * c.get(b, 0) / st:.0f}%)"
                                                            for b in ("ccli", "historical", "new")))
            if args.songs:
                print(f"\n{'bucket':<11}{'slots':>5}{'uses':>5}  {'first':<10} {'last':<10} title")
                for sid, s in sorted(rep["songs"].items(), key=lambda kv: (-kv[1]["slots"], kv[1]["title"])):
                    b = "/".join(sorted(s["buckets"]))
                    print(f"{b:<11}{s['slots']:>5}{s['uses_total']:>5}  {s['first_used']:<10} {s['last_used']:<10} {s['title']}")
            return 0
        if args.songs_op == "flag":
            import csv, os
            ids = [x.strip() for x in args.ids.split(",") if x.strip()]
            if args.csv:
                with open(args.csv, newline="", encoding="utf-8") as f:
                    ids += [r["song"].strip() for r in csv.DictReader(f) if r.get("song", "").strip()]
            if not ids and not args.clear:
                raise RuntimeError("flag needs --ids and/or --csv (or --clear)")
            state = args.state or os.path.expanduser(f"~/.local/share/pco/{profile or 'default'}/flags.json")
            index = SV.TagIndex(client)
            r = SV.flag_songs(client, index, args.tag, [] if args.clear else ids, state, note=args.note,
                              dry_run=args.dry_run, log=lambda m: print(m, file=sys.stderr))
            print(f"{args.tag}: +{len(r['added'])} -{len(r['removed'])} ={len(r['kept'])} kept"
                  + ("  [dry-run]" if args.dry_run else f"  (state: {state})"))
            return 0
        if args.songs_op == "lifecycle":
            import csv
            if not (args.usage and args.from_json):
                raise RuntimeError("lifecycle needs --usage all.csv --from library.json")
            with open(args.from_json, encoding="utf-8") as f:
                lib = json.load(f)
            with open(args.usage, newline="", encoding="utf-8") as f:
                usage = list(csv.DictReader(f))
            as_of = args.as_of or dt.date.today()
            # The one online step: library.json's tags go stale the moment a tag is
            # deleted in the UI, so ask PCO whether the superseded tag still exists.
            current_tag = None
            if args.current_tag:
                hits = [t["name"] for g in SV.get_tag_groups(client) if g["tags_for"] == "song"
                        for t in g["tags"] if t["name"].lower() == args.current_tag.lower()]
                current_tag = hits[0] if hits else None
            rep = SV.lifecycle_states(usage, lib, as_of, new_threshold=args.new_threshold, intro_weeks=args.intro_weeks,
                                      skip_intro_arr_tags=tuple(t.strip() for t in args.skip_intro_arr_tags.split(",") if t.strip()),
                                      dormant_months=args.dormant_months,
                                      seasonal_tags=tuple(t.strip() for t in args.seasonal_tags.split(",") if t.strip()),
                                      current_tag=current_tag)
